generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USUÁRIOS ────────────────────────────────────────────────────────────────

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String
  avatar      String?
  passwordHash String  @map("password_hash")
  role        Role     @default(READER)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  articles        Article[]   @relation("AuthorArticles")
  listings        Listing[]
  assignedReports Report[]    @relation("AssignedReports")
  auditLogs       AuditLog[]

  @@map("users")
}

enum Role {
  READER
  JOURNALIST
  EDITOR
  ADMIN
}

// ─── ARTIGOS ─────────────────────────────────────────────────────────────────

model Article {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  description String
  content     String        @db.Text
  image       String
  status      ArticleStatus @default(DRAFT)
  publishedAt DateTime?     @map("published_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  views       Int           @default(0)
  readTime    Int           @default(3) @map("read_time")
  isLive      Boolean       @default(false) @map("is_live")
  isFeatured  Boolean       @default(false) @map("is_featured")
  isSponsored Boolean       @default(false) @map("is_sponsored")
  sponsor     String?

  authorId    String      @map("author_id")
  author      User        @relation("AuthorArticles", fields: [authorId], references: [id])
  categoryId  String      @map("category_id")
  category    Category    @relation(fields: [categoryId], references: [id])

  @@index([slug])
  @@index([categoryId])
  @@index([status, publishedAt(sort: Desc)])
  @@map("articles")
}

enum ArticleStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

// ─── CATEGORIAS ──────────────────────────────────────────────────────────────

model Category {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  articles Article[]

  @@map("categories")
}

// ─── AGENDA CULTURAL ─────────────────────────────────────────────────────────

model Event {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  description  String   @db.Text
  category     String
  startDate    DateTime @map("start_date")
  endDate      DateTime? @map("end_date")
  time         String?
  venue        String
  neighborhood String?
  address      String?
  price        String?
  isFree       Boolean  @default(false) @map("is_free")
  image        String
  ageRating    String?  @map("age_rating")
  organizer    String?
  isHighlighted Boolean @default(false) @map("is_highlighted")
  isSponsored  Boolean  @default(false) @map("is_sponsored")
  sponsor      String?
  tags         String[]
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([slug])
  @@index([startDate])
  @@map("events")
}

// ─── CLASSIFICADOS ───────────────────────────────────────────────────────────

model Listing {
  id          String        @id @default(cuid())
  title       String
  description String        @db.Text
  category    String
  type        ListingType
  price       Float?
  images      String[]
  status      ListingStatus @default(PENDING)
  views       Int           @default(0)
  isFeatured  Boolean       @default(false) @map("is_featured")
  expiresAt   DateTime?     @map("expires_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  userId      String       @map("user_id")
  user        User         @relation(fields: [userId], references: [id])
  contact     ListingContact?

  @@index([status])
  @@index([category, status])
  @@map("listings")
}

model ListingContact {
  id        String  @id @default(cuid())
  name      String
  phone     String
  email     String
  whatsapp  String?
  location  String

  listingId String  @unique @map("listing_id")
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("listing_contacts")
}

enum ListingType {
  SALE
  PURCHASE
  SERVICE
  JOB
  OTHER
}

enum ListingStatus {
  PENDING
  ACTIVE
  REFUSED
  EXPIRED
  PAUSED
}

// ─── DENÚNCIAS ───────────────────────────────────────────────────────────────

model Report {
  id           String         @id @default(cuid())
  protocol     String         @unique
  type         ReportType
  name         String?
  phone        String?
  email        String?
  location     String?
  description  String         @db.Text
  status       ReportStatus   @default(RECEIVED)
  notes        String?        @db.Text
  assignedToId String?        @map("assigned_to_id")
  assignedTo   User?          @relation("AssignedReports", fields: [assignedToId], references: [id])
  history      ReportHistory[]
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@index([protocol])
  @@index([status])
  @@map("reports")
}

model ReportHistory {
  id         String       @id @default(cuid())
  reportId   String       @map("report_id")
  report     Report       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  fromStatus ReportStatus @map("from_status")
  toStatus   ReportStatus @map("to_status")
  notes      String?      @db.Text
  userId     String       @map("user_id")
  createdAt  DateTime     @default(now()) @map("created_at")

  @@index([reportId])
  @@map("report_history")
}

enum ReportType {
  POLICIAL
  URBANO
  PAUTA
  MIDIA
  ANONIMA
}

enum ReportStatus {
  RECEIVED
  UNDER_REVIEW
  VERIFIED
  PUBLISHED
  CLOSED
  REJECTED
  REVIEW
  RESOLVED
}

// ─── AUDITORIA ───────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail String   @map("user_email")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  details   Json?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ─── NEWSLETTER ──────────────────────────────────────────────────────────────

model Newsletter {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String?
  confirmedAt DateTime? @map("confirmed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("newsletters")
}

// ─── ANALYTICS ───────────────────────────────────────────────────────────────

model PageView {
  id        String   @id @default(cuid())
  path      String
  articleId String?  @map("article_id")
  sessionId String   @map("session_id")
  userAgent String?  @map("user_agent")
  country   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([path, createdAt])
  @@index([articleId])
  @@map("page_views")
}
