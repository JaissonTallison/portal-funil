# ─── PortalFunil Web — Variáveis de Produção ─────────────────────────────────
# Copie para .env.production no servidor e preencha todos os valores
# NUNCA commite este arquivo com valores reais

# URL pública da API — usada pelo navegador E para gerar remotePatterns/CSP no build
# Railway: https://gleaming-fascination-production-XXXX.up.railway.app/api/v1
# VPS nginx: https://funildenoticias.com.br/api/v1
NEXT_PUBLIC_API_URL="https://funildenoticias.com.br/api/v1"

# URL interna da API — usada apenas pelo servidor Next.js (SSR/server components)
# Railway: usa private networking (mais rápido, sem passar pela internet pública)
# Formato Railway: http://<private-name>.railway.internal/api/v1
# VPS: deixar igual ao NEXT_PUBLIC_API_URL
INTERNAL_API_URL="http://gleaming-fascination.railway.internal/api/v1"

# URL pública do site (para SEO e Open Graph)
NEXT_PUBLIC_SITE_URL="https://funildenoticias.com.br"
