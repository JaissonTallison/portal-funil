# ─── PortalFunil Web — Variáveis de Produção ─────────────────────────────────
# Copie para .env.production no servidor e preencha todos os valores
# NUNCA commite este arquivo com valores reais

# URL pública da API — usada pelo navegador
# Se API e frontend estão no mesmo domínio via nginx:
NEXT_PUBLIC_API_URL="https://funildenoticias.com.br/api/v1"

# URL pública do site (para SEO e Open Graph)
NEXT_PUBLIC_SITE_URL="https://funildenoticias.com.br"
