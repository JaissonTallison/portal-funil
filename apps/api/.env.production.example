# ─── PortalFunil API — Variáveis de Produção ─────────────────────────────────
# Copie para .env no servidor e preencha todos os valores
# NUNCA commite este arquivo com valores reais

# Banco de dados
# Em produção, postgres fica em 127.0.0.1 (docker bind)
DATABASE_URL="postgresql://portalfunil:SENHA_FORTE@127.0.0.1:5433/portalfunil"

# JWT — gere com: openssl rand -hex 32
JWT_SECRET="GERE_COM_openssl_rand_hex_32"

# CORS — URL exata do frontend (sem barra no final)
WEB_URL="https://funildenoticias.com.br"

# Porta interna da API (nginx faz proxy reverso)
PORT=3002

# Ambiente
NODE_ENV="production"
